# Environment variables for canopy-website
# Copy to .env.local for local development. Set the same values in the Vercel
# project (Settings -> Environment Variables) for production.

# --- Demo-form ingest ---
# The demo form does NOT connect to Postgres directly. It forwards submissions
# to the in-cluster ingest shim, which is exposed over HTTPS via Tailscale
# Funnel (port 443) and writes to the canopy-website Postgres in the homelab.
#
# Full URL of the shim's POST endpoint (note the /demo path):
INGEST_URL=https://canopy-website-ingest.your-tailnet.ts.net/demo
# Shared bearer secret. Must match the `ingest-secret` key of the
# canopy-website-ingest-secret Kubernetes secret. Retrieve it with:
#   kubectl get secret canopy-website-ingest-secret -n canopy-website \
#     -o jsonpath='{.data.ingest-secret}' | base64 -d
INGEST_SECRET=replace-with-shared-secret

# --- Email fallback (optional but recommended) ---
# If the ingest shim is unreachable, submissions are emailed here instead so a
# lead is never lost.
# RESEND_API_KEY=re_xxxxxxxx

# --- Branding ---
# Logo variant selection: hex (default) or leafy
PUBLIC_LOGO_VARIANT=hex
